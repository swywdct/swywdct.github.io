---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(100%, 520px);
				padding-top: 2rem;
				padding-bottom: 2rem;
			}
			.game-shell {
				display: grid;
				grid-template-columns: minmax(0, 220px) auto;
				justify-content: center;
				gap: 0.75rem;
				align-items: start;
			}
			.board {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				grid-template-rows: repeat(12, minmax(0, 1fr));
				width: min(100%, 220px);
				aspect-ratio: 4 / 12;
				border: 2px solid rgb(var(--black));
				background: #151820;
			}
			.board :global(.cell) {
				min-width: 0;
				border: 1px solid rgba(255, 255, 255, 8%);
				background: #1b1f29;
			}
			.board :global(.cell.filled) {
				border: 1px solid rgba(255, 255, 255, 45%);
				background: var(--piece-color, #6c63ff);
			}
			.game-panel {
				display: grid;
				gap: 0.75rem;
			}
			.score {
				color: rgb(var(--black));
				font-size: 1.2rem;
				font-variant-numeric: tabular-nums;
				font-weight: 700;
				line-height: 1;
			}
			.preview-piece {
				display: grid;
				grid-template-columns: repeat(4, 18px);
				grid-template-rows: repeat(2, 18px);
				width: max-content;
				border: 1px solid rgb(var(--gray-light));
				background: #151820;
			}
			.preview-piece :global(.preview-cell) {
				border: 1px solid rgba(255, 255, 255, 8%);
			}
			.preview-piece :global(.preview-cell.filled) {
				background: var(--piece-color, #6c63ff);
			}
			.next-queue {
				display: grid;
				gap: 0.4rem;
			}
			.keymap {
				display: grid;
				gap: 0.3rem;
				border: 1px solid rgb(var(--gray-light));
				padding: 0.55rem;
				color: rgb(var(--gray-dark));
				font-size: 0.72rem;
				line-height: 1.35;
			}
			.keymap div {
				display: grid;
				grid-template-columns: auto 1fr;
				gap: 0.5rem;
				align-items: baseline;
			}
			.keymap kbd {
				min-width: 2.5em;
				color: rgb(var(--black));
				font: inherit;
				font-weight: 700;
			}
			.status {
				position: absolute;
				width: 1px;
				height: 1px;
				overflow: hidden;
				clip-path: inset(50%);
			}
			@media (max-width: 420px) {
				.game-shell {
					grid-template-columns: minmax(0, 180px) auto;
					gap: 0.5rem;
				}
				.board {
					width: 180px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="game-shell" aria-label="俄罗斯方块游戏">
				<div class="board" data-board aria-label="游戏棋盘" role="grid"></div>
				<aside class="game-panel">
					<div class="preview-piece" data-hold aria-label="暂存方块"></div>
					<div class="next-queue" aria-label="未来四块">
						<div class="preview-piece" data-next-slot></div>
						<div class="preview-piece" data-next-slot></div>
						<div class="preview-piece" data-next-slot></div>
						<div class="preview-piece" data-next-slot></div>
					</div>
					<output class="score" data-score aria-label="分数">0</output>
					<div class="keymap" aria-label="按键说明">
						<div><kbd>← →</kbd><span>移动</span></div>
						<div><kbd>Z / X</kbd><span>旋转</span></div>
						<div><kbd>↓</kbd><span>软降</span></div>
						<div><kbd>Space</kbd><span>硬降</span></div>
						<div><kbd>C</kbd><span>暂存</span></div>
						<div><kbd>P / R</kbd><span>暂停 / 重开</span></div>
					</div>
					<p class="status" data-status aria-live="polite">游戏进行中</p>
				</aside>
			</section>
		</main>
		<script is:inline>
			const COLS = 4;
			const ROWS = 12;
			const DAS = 140;
			const ARR = 40;
			const LOCK_DELAY = 500;
			const SHAPES = [
				{ kind: 'I', color: '#4cc9f0', cells: [[0, 1], [1, 1], [2, 1], [3, 1]] },
				{ kind: 'O', color: '#f9c74f', cells: [[0, 0], [1, 0], [0, 1], [1, 1]] },
				{ kind: 'L', color: '#f8961e', cells: [[0, 0], [0, 1], [1, 1], [2, 1]] },
				{ kind: 'J', color: '#90be6d', cells: [[2, 0], [0, 1], [1, 1], [2, 1]] },
				{ kind: 'Z', color: '#f94144', cells: [[1, 0], [2, 0], [0, 1], [1, 1]] },
				{ kind: 'T', color: '#9b5de5', cells: [[1, 0], [0, 1], [1, 1], [2, 1]] },
				{ kind: 'S', color: '#43aa8b', cells: [[0, 0], [1, 0], [1, 1], [2, 1]] },
			];
			// SRS kick offsets converted from upward-positive coordinates to screen coordinates.
			const JLSTZ_KICKS = {
				'0>1': [[0, 0], [-1, 0], [-1, -1], [0, 2], [-1, 2]],
				'1>0': [[0, 0], [1, 0], [1, 1], [0, -2], [1, -2]],
				'1>2': [[0, 0], [1, 0], [1, 1], [0, -2], [1, -2]],
				'2>1': [[0, 0], [-1, 0], [-1, -1], [0, 2], [-1, 2]],
				'2>3': [[0, 0], [1, 0], [1, -1], [0, 2], [1, 2]],
				'3>2': [[0, 0], [-1, 0], [-1, 1], [0, -2], [-1, -2]],
				'3>0': [[0, 0], [-1, 0], [-1, 1], [0, -2], [-1, -2]],
				'0>3': [[0, 0], [1, 0], [1, -1], [0, 2], [1, 2]],
			};
			const I_KICKS = {
				'0>1': [[0, 0], [-2, 0], [1, 0], [-2, 1], [1, -2]],
				'1>0': [[0, 0], [2, 0], [-1, 0], [2, -1], [-1, 2]],
				'1>2': [[0, 0], [-1, 0], [2, 0], [-1, -2], [2, 1]],
				'2>1': [[0, 0], [1, 0], [-2, 0], [1, 2], [-2, -1]],
				'2>3': [[0, 0], [2, 0], [-1, 0], [2, -1], [-1, 2]],
				'3>2': [[0, 0], [-2, 0], [1, 0], [-2, 1], [1, -2]],
				'3>0': [[0, 0], [1, 0], [-2, 0], [1, 2], [-2, -1]],
				'0>3': [[0, 0], [-1, 0], [2, 0], [-1, -2], [2, 1]],
			};
			const boardElement = document.querySelector('[data-board]');
			const holdElement = document.querySelector('[data-hold]');
			const nextElements = document.querySelectorAll('[data-next-slot]');
			const scoreElement = document.querySelector('[data-score]');
			const statusElement = document.querySelector('[data-status]');
			const cells = [];
			const previewSlots = [];
			let board;
			let current;
			let pieceQueue;
			let heldPiece;
			let canHold;
			let score;
			let lines;
			let paused;
			let gameOver;
			let lastDrop;
			let lockStartedAt;
			let horizontalDirection;
			let horizontalRepeatAt;
			const heldHorizontalKeys = new Set();
			let animationFrame;

			for (let index = 0; index < COLS * ROWS; index += 1) {
				const cell = document.createElement('div');
				cell.className = 'cell';
				cell.setAttribute('role', 'gridcell');
				boardElement.append(cell);
				cells.push(cell);
			}

			function createPreviewSlot(element) {
				const slot = { cells: [] };
				for (let index = 0; index < 8; index += 1) {
					const cell = document.createElement('div');
					cell.className = 'preview-cell';
					element.append(cell);
					slot.cells.push(cell);
				}
				return slot;
			}

			previewSlots.push(createPreviewSlot(holdElement));
			nextElements.forEach((element) => previewSlots.push(createPreviewSlot(element)));

			function createPiece(shape) {
				return { shape, rotation: 0, x: 0, y: 0 };
			}

			function createBag() {
				const bag = [...SHAPES];
				for (let index = bag.length - 1; index > 0; index -= 1) {
					const swapIndex = Math.floor(Math.random() * (index + 1));
					[bag[index], bag[swapIndex]] = [bag[swapIndex], bag[index]];
				}
				return bag;
			}

			function refillQueue() {
				while (pieceQueue.length < 28) pieceQueue.push(...createBag());
			}

			function renderPreview(slot, shape) {
				slot.cells.forEach((cell) => {
					cell.className = 'preview-cell';
					cell.style.removeProperty('--piece-color');
				});
				if (!shape) return;
				shape.cells.forEach(([x, y]) => {
					const cell = slot.cells[y * 4 + x];
					if (cell) {
						cell.classList.add('filled');
						cell.style.setProperty('--piece-color', shape.color);
					}
				});
			}

			function renderPreviews() {
				renderPreview(previewSlots[0], heldPiece);
				for (let index = 0; index < 4; index += 1) renderPreview(previewSlots[index + 1], pieceQueue[index]);
			}

			function takeNextPiece() {
				refillQueue();
				const shape = pieceQueue.shift();
				refillQueue();
				return createPiece(shape);
			}

			function rotatedCells(piece) {
				let result = piece.shape.cells.map(([x, y]) => [x, y]);
				for (let turn = 0; turn < piece.rotation; turn += 1) {
					result = result.map(([x, y]) => [-y, x]);
					const minX = Math.min(...result.map(([x]) => x));
					const minY = Math.min(...result.map(([, y]) => y));
					result = result.map(([x, y]) => [x - minX, y - minY]);
				}
				return result;
			}

			function canPlace(piece, offsetX = piece.x, offsetY = piece.y, rotation = piece.rotation) {
				const testPiece = { ...piece, rotation };
				return rotatedCells(testPiece).every(([x, y]) => {
					const boardX = offsetX + x;
					const boardY = offsetY + y;
					return boardX >= 0 && boardX < COLS && boardY >= 0 && boardY < ROWS && !board[boardY][boardX];
				});
			}

			function spawn(piece = takeNextPiece()) {
				current = piece;
				current.x = Math.floor((COLS - Math.max(...rotatedCells(current).map(([x]) => x)) - 1) / 2);
				current.y = 0;
				canHold = true;
				if (!canPlace(current)) {
					gameOver = true;
					statusElement.textContent = '游戏结束';
				}
				renderPreviews();
			}

			function merge() {
				rotatedCells(current).forEach(([x, y]) => {
					board[current.y + y][current.x + x] = current.shape.color;
				});
			}

			function clearLines() {
				const remaining = board.filter((row) => row.some((cell) => !cell));
				const cleared = ROWS - remaining.length;
				while (remaining.length < ROWS) remaining.unshift(Array(COLS).fill(''));
				board = remaining;
				if (cleared) {
					lines += cleared;
					score += [0, 100, 300, 500, 800][cleared] || cleared * 200;
				}
			}

			function lockPiece() {
				merge();
				clearLines();
				lockStartedAt = 0;
				spawn();
			}

			function isGrounded() {
				return !canPlace(current, current.x, current.y + 1);
			}

			function move(dx, dy = 0) {
				if (paused || gameOver) return false;
				if (canPlace(current, current.x + dx, current.y + dy)) {
					current.x += dx;
					current.y += dy;
					if (dx) lockStartedAt = 0;
					return true;
				}
				return false;
			}

			function rotate(direction = 1) {
				if (paused || gameOver) return;
				if (current.shape.kind === 'O') return;
				const rotation = (current.rotation + direction + 4) % 4;
				const kicks = (current.shape.kind === 'I' ? I_KICKS : JLSTZ_KICKS)[`${current.rotation}>${rotation}`];
				for (const [offsetX, offsetY] of kicks) {
					if (canPlace(current, current.x + offsetX, current.y + offsetY, rotation)) {
						current.x += offsetX;
						current.y += offsetY;
						current.rotation = rotation;
						lockStartedAt = 0;
						return;
					}
				}
			}

			function drop() {
				if (paused || gameOver) return;
				while (move(0, 1)) score += 2;
				lockPiece();
				render();
			}

			function hold() {
				if (paused || gameOver || !canHold) return;
				const outgoingShape = current.shape;
				if (heldPiece) {
					const incomingShape = heldPiece;
					heldPiece = outgoingShape;
					spawn(createPiece(incomingShape));
				} else {
					heldPiece = outgoingShape;
					spawn();
				}
				canHold = false;
				lockStartedAt = 0;
				renderPreviews();
			}

			function setHorizontalDirection(direction) {
				horizontalDirection = direction;
				move(direction);
				horizontalRepeatAt = performance.now() + DAS;
			}

			function updateHeldDirection() {
				const direction = heldHorizontalKeys.has('ArrowLeft') ? -1 : heldHorizontalKeys.has('ArrowRight') ? 1 : 0;
				if (direction !== horizontalDirection) {
					horizontalDirection = direction;
					if (direction) {
						move(direction);
						horizontalRepeatAt = performance.now() + DAS;
					}
				}
			}

			function repeatHorizontalMove(timestamp) {
				if (!horizontalDirection || timestamp < horizontalRepeatAt) return;
				move(horizontalDirection);
				horizontalRepeatAt = timestamp + ARR;
			}

			function render() {
				cells.forEach((cell) => {
					cell.className = 'cell';
					cell.style.removeProperty('--piece-color');
				});
				board.forEach((row, y) => row.forEach((color, x) => {
					if (color) {
						cells[y * COLS + x].classList.add('filled');
						cells[y * COLS + x].style.setProperty('--piece-color', color);
					}
				}));
				if (current && !gameOver) {
					rotatedCells(current).forEach(([x, y]) => {
						const cell = cells[(current.y + y) * COLS + current.x + x];
						if (cell) {
							cell.classList.add('filled');
							cell.style.setProperty('--piece-color', current.shape.color);
						}
					});
				}
				scoreElement.textContent = String(score);
			}

			function loop(timestamp) {
				if (!lastDrop) lastDrop = timestamp;
				if (!paused && !gameOver) {
					repeatHorizontalMove(timestamp);
					if (timestamp - lastDrop > Math.max(180, 650 - lines * 25)) {
						move(0, 1);
						lastDrop = timestamp;
					}
					if (isGrounded()) {
						if (!lockStartedAt) lockStartedAt = timestamp;
						else if (timestamp - lockStartedAt >= LOCK_DELAY) lockPiece();
					} else {
						lockStartedAt = 0;
					}
				}
				render();
				animationFrame = requestAnimationFrame(loop);
			}

			function togglePause() {
				if (gameOver) return;
				paused = !paused;
				statusElement.textContent = paused ? '已暂停' : '游戏进行中';
			}

			function restart() {
				board = Array.from({ length: ROWS }, () => Array(COLS).fill(''));
				score = 0;
				lines = 0;
				paused = false;
				gameOver = false;
				lastDrop = 0;
				lockStartedAt = 0;
				horizontalDirection = 0;
				horizontalRepeatAt = 0;
				heldHorizontalKeys.clear();
				statusElement.textContent = '游戏进行中';
				pieceQueue = [];
				heldPiece = null;
				canHold = true;
				refillQueue();
				spawn();
				render();
			}

			document.addEventListener('keydown', (event) => {
				if (['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', ' ', 'z', 'Z', 'x', 'X', 'c', 'C', 'p', 'P', 'r', 'R'].includes(event.key)) event.preventDefault();
				if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
					if (!event.repeat) {
						heldHorizontalKeys.add(event.key);
						setHorizontalDirection(event.key === 'ArrowLeft' ? -1 : 1);
					}
					render();
					return;
				}
				switch (event.key) {
					case 'ArrowUp': rotate(); break;
					case 'z':
					case 'Z': rotate(-1); break;
					case 'x':
					case 'X': rotate(1); break;
					case 'c':
					case 'C': hold(); break;
					case 'ArrowDown': move(0, 1); break;
					case ' ': drop(); break;
					case 'p':
					case 'P': togglePause(); break;
					case 'r':
					case 'R': restart(); break;
				}
				render();
			});

			document.addEventListener('keyup', (event) => {
				if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
					heldHorizontalKeys.delete(event.key);
					updateHeldDirection();
				}
			});

			window.addEventListener('blur', () => {
				heldHorizontalKeys.clear();
				horizontalDirection = 0;
			});

			restart();
			animationFrame = requestAnimationFrame(loop);
		</script>
		<Footer />
	</body>
</html>
